---
import LanguagePicker from "./LanguagePicker.astro";
import { localizePath } from "astro-i18next";
import { t } from "i18next";

// Persist per language: a shared name would keep the previous language's text after switching.
const lang = /^\/en(\/|$)/.test(Astro.url.pathname) ? "en" : "es";

const navLinks = [
  { href: "/proyectos", label: "nav.projects" },
  { href: "/ingenieria", label: "nav.engineering" },
  { href: "/negocios", label: "nav.business" },
  { href: "/sobre-mi", label: "nav.about" },
];
---

<header class="sticky top-0 z-50 bg-ink/80 backdrop-blur-md border-b hairline" transition:persist={`site-header-${lang}`}>
  <nav class="max-w-6xl mx-auto px-6 lg:px-12">
    <div class="flex justify-between items-center h-20">
      <a
        href={localizePath("/")}
        class="group inline-flex items-center gap-3 font-mono text-sm font-medium tracking-tight text-paper hover:text-paper-muted transition-colors"
      >
        <!-- Same mark as /favicon.svg, drawn with theme tokens so it inverts in dark mode -->
        <svg class="h-8 w-8 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="var(--text)" />
          <rect x="6.2" y="7" width="8.4" height="3.4" fill="var(--bg)" />
          <path d="M12.8 8.5v10.9c0 2.6-1.4 3.9-3.9 3.9H6.6" fill="none" stroke="var(--bg)" stroke-width="3.6" stroke-linecap="square" stroke-linejoin="round" />
          <rect x="17.4" y="7" width="3.6" height="18" fill="var(--bg)" />
          <rect x="17.4" y="7" width="8.6" height="3.4" fill="var(--bg)" />
          <rect x="17.4" y="14.4" width="6.8" height="3.2" fill="var(--bg)" />
          <rect x="23" y="21.8" width="3.2" height="3.2" rx="0.5" fill="var(--text-dim)" />
        </svg>
        <span>jfrankrobles<span class="text-paper-dim">.</span></span>
      </a>

      <div class="hidden md:flex md:items-center md:gap-8">
        {navLinks.map((link) => (
          <a
            href={localizePath(link.href)}
            class="text-sm text-paper-muted hover:text-paper transition-colors"
          >
            {t(link.label)}
          </a>
        ))}
        <span class="h-4 border-l hairline" aria-hidden="true"></span>
        <LanguagePicker />
        <button
          type="button"
          data-theme-toggle
          class="editorial-meta text-paper-dim hover:text-paper transition-colors theme-toggle"
        >
          <span data-theme-label-dark>{t("nav.themeToLight")}</span>
          <span data-theme-label-light>{t("nav.themeToDark")}</span>
        </button>
        <a href={localizePath("/contacto")} class="btn btn-primary !py-2 !px-4 text-sm">
          {t("nav.contact")}
        </a>
      </div>

      <div class="md:hidden">
        <button
          id="mobile-menu-button"
          type="button"
          class="text-paper hover:text-paper-muted p-2"
          aria-label="Menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="hidden md:hidden pb-6 border-t hairline"
    >
      <div class="flex flex-col gap-1 pt-4">
        {navLinks.map((link) => (
          <a
            href={localizePath(link.href)}
            class="text-base text-paper py-3 hover:text-paper-muted transition-colors"
          >
            {t(link.label)}
          </a>
        ))}
        <div class="py-3 flex items-center gap-6">
          <LanguagePicker />
          <button
            type="button"
            data-theme-toggle
            class="editorial-meta text-paper-dim hover:text-paper transition-colors theme-toggle"
          >
            <span data-theme-label-dark>{t("nav.themeToLight")}</span>
            <span data-theme-label-light>{t("nav.themeToDark")}</span>
          </button>
        </div>
        <a href={localizePath("/contacto")} class="btn btn-primary justify-center mt-2">
          {t("nav.contact")}
        </a>
      </div>
    </div>
  </nav>
</header>

<style>
  .theme-toggle [data-theme-label-dark],
  .theme-toggle [data-theme-label-light] {
    display: none;
  }
  :root[data-theme="dark"] .theme-toggle [data-theme-label-dark],
  :root[data-theme="light"] .theme-toggle [data-theme-label-light] {
    display: inline;
  }
</style>

<script>
  function bindHeader() {
    const menuButton = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");

    if (menuButton && !menuButton.dataset.bound) {
      menuButton.dataset.bound = "true";
      menuButton.addEventListener("click", () => {
        const expanded = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!expanded));
        menu?.classList.toggle("hidden");
      });
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
      .forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = "true";
        btn.addEventListener("click", () => {
          const current =
            document.documentElement.getAttribute("data-theme") ?? "dark";
          const next = current === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (e) {
            /* ignore */
          }
        });
      });
  }

  bindHeader();
  document.addEventListener("astro:page-load", bindHeader);
</script>
