---
import { SOCIAL_LINKS, SITE_AUTHOR } from "../consts";
import { localizePath } from "astro-i18next";
import { t } from "i18next";

const currentYear = new Date().getFullYear();
const SITE_START_YEAR = 2024;
const yearRange =
  currentYear > SITE_START_YEAR
    ? `${SITE_START_YEAR}–${currentYear}`
    : `${SITE_START_YEAR}`;

// Persist per language: a shared name would keep the previous language's text after switching.
const lang = /^\/en(\/|$)/.test(Astro.url.pathname) ? "en" : "es";

const footerLinks = [
  { href: "/", label: "nav.home" },
  { href: "/proyectos", label: "nav.projects" },
  { href: "/ingenieria", label: "nav.engineering" },
  { href: "/negocios", label: "nav.business" },
  { href: "/sobre-mi", label: "nav.about" },
  { href: "/contacto", label: "nav.contact" },
];
---

<footer class="bg-ink border-t hairline" transition:persist={`site-footer-${lang}`}>
  <div class="max-w-6xl mx-auto px-6 lg:px-12 py-14">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
      <div class="md:col-span-5">
        <p class="editorial-meta mb-4">{t("footer.contact")}</p>
        <a
          href={`mailto:${SOCIAL_LINKS.email}`}
          class="text-lg text-paper hover:text-paper-muted transition-colors break-all"
        >
          {SOCIAL_LINKS.email}
          <span class="text-paper-dim"> →</span>
        </a>
      </div>

      <div class="md:col-span-3 md:col-start-7">
        <p class="editorial-meta mb-4">{t("footer.navigation")}</p>
        <ul class="space-y-2">
          {footerLinks.map((link) => (
            <li>
              <a href={localizePath(link.href)} class="text-paper hover:text-paper-muted transition-colors">
                {t(link.label)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="editorial-meta mb-4">Social</p>
        <ul class="space-y-2">
          <li>
            <a
              href={SOCIAL_LINKS.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-paper hover:text-paper-muted transition-colors"
            >
              LinkedIn ↗
            </a>
          </li>
          <li>
            <a
              href={SOCIAL_LINKS.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-paper hover:text-paper-muted transition-colors"
            >
              GitHub ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t hairline mt-12 pt-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <p class="editorial-meta">
        © {yearRange} — {SITE_AUTHOR}
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a
          href={localizePath("/sitemap")}
          class="editorial-meta text-paper-dim hover:text-paper transition-colors"
        >
          Sitemap
        </a>
        <p class="editorial-meta">
          {t("footer.madeWith")} Astro + Tailwind
        </p>
      </div>
    </div>
  </div>
</footer>
