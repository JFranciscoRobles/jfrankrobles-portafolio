---
import { t } from "i18next";
import { localizePath } from "astro-i18next";
import { SOCIAL_LINKS } from "../consts";
import { projects } from "../data/projects";

interface Props {
  locale?: "es" | "en";
}

const { locale = "es" } = Astro.props;

const featuredSlugs = ["rebodocs", "zeitap", "probien-crm"];
const featuredProjects = featuredSlugs
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<!-- Hero -->
<section class="border-b hairline">
  <div class="max-w-6xl mx-auto px-6 lg:px-12 pt-16 pb-20 md:pt-28 md:pb-28">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 items-end">
      <div class="md:col-span-8">
        <p class="editorial-meta mb-8">{t("home.badge")}</p>

        <h1 class="editorial-display text-[2.5rem] sm:text-[3.5rem] md:text-[5rem] lg:text-[6rem] text-paper text-balance">
          <span class="text-paper-muted">{t("home.greeting")}</span>
          <br />
          {t("home.name")}.
        </h1>
      </div>

      <div class="md:col-span-4 md:col-start-9">
        <div class="border-l hairline pl-6">
          <p class="text-paper-muted text-base leading-relaxed mb-4 text-pretty" set:html={t("home.description1")} />
          <p class="text-paper-dim text-sm leading-relaxed text-pretty" set:html={t("home.description2")} />
        </div>
      </div>
    </div>

    <div class="mt-12 md:mt-16 flex flex-wrap items-center gap-4">
      <a href={localizePath("/proyectos")} class="btn btn-primary">
        {t("home.viewAllProjects")} <span aria-hidden="true">→</span>
      </a>
      <a href={localizePath("/contacto")} class="btn btn-secondary">
        {t("nav.contact")}
      </a>
    </div>
  </div>
</section>

<!-- Portrait + presentación -->
<section class="border-b hairline bg-ink-raised">
  <div class="max-w-6xl mx-auto px-6 lg:px-12 py-16 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-center">
      <div class="md:col-span-5">
        <div class="aspect-[3/4] bg-ink overflow-hidden">
          <img
            src="/yo.jpg"
            alt="J. Francisco Robles"
            width="600"
            height="800"
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <div class="md:col-span-6 md:col-start-7">
        <h2 class="editorial-display text-3xl md:text-5xl text-paper mb-8 text-balance">
          {t("home.whoIHelp")}
        </h2>
        <p class="text-paper-muted text-lg leading-relaxed text-pretty">
          {t("home.whoIHelpLead")}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Selected work -->
<section class="border-b hairline">
  <div class="max-w-6xl mx-auto px-6 lg:px-12 py-16 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-16 md:mb-20 items-end">
      <div class="md:col-span-7">
        <h2 class="editorial-display text-3xl md:text-5xl text-paper text-balance">
          {t("home.selectedWork")}
        </h2>
      </div>
      <div class="md:col-span-4 md:col-start-9">
        <p class="text-paper-muted leading-relaxed text-pretty">
          {t("home.selectedWorkDesc")}
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-line">
      {featuredProjects.map((project) => (
        <a
          href={`${localizePath("/proyectos")}/${project.slug}`}
          class="group block bg-ink p-6 md:p-8 hover:bg-ink-raised transition-colors"
        >
          <div class="aspect-[4/3] bg-ink-raised overflow-hidden mb-6 border hairline">
            <img
              src={project.cover}
              alt={project.title}
              width="800"
              height="600"
              loading="lazy"
              class="w-full h-full object-cover group-hover:opacity-90 transition-opacity"
            />
          </div>
          <p class="editorial-meta text-paper-dim mb-3">{project.year}</p>
          <h3 class="editorial-display text-xl md:text-2xl text-paper mb-3 group-hover:text-paper-muted transition-colors">
            {project.title}
          </h3>
          <p class="text-paper-muted text-sm leading-relaxed mb-6 text-pretty">
            {project.tagline[locale]}
          </p>
          {project.metrics && project.metrics.length > 0 && (
            <dl class="flex flex-wrap gap-x-6 gap-y-3 border-t hairline pt-5">
              {project.metrics.slice(0, 2).map((metric) => (
                <div>
                  <dt class="editorial-meta text-paper-dim mb-1">
                    {metric.label[locale]}
                  </dt>
                  <dd class="text-paper text-base">{metric.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </a>
      ))}
    </div>

    <div class="mt-12">
      <a href={localizePath("/proyectos")} class="btn btn-secondary">
        {t("home.viewAllProjects")}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<!-- Dos audiencias -->
<section>
  <div class="max-w-6xl mx-auto px-6 lg:px-12 py-16 md:py-24">
    <h2 class="editorial-display text-3xl md:text-5xl text-paper mb-4 text-balance">
      {t("home.servicesTitle")}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2">
      <a
        href={localizePath("/ingenieria")}
        class="group block py-10 md:py-14 md:pr-12 border-b md:border-b-0 md:border-r hairline"
      >
        <h3 class="editorial-display text-2xl md:text-4xl text-paper mb-6 group-hover:text-paper-muted transition-colors duration-300">
          {t("home.forRecruiters")}
        </h3>
        <p class="text-paper-muted leading-relaxed mb-8 text-pretty">
          {t("home.forRecruitersDesc")}
        </p>
        <span class="editorial-meta text-paper inline-flex items-center gap-2 border-b border-paper pb-1 group-hover:border-paper-muted group-hover:text-paper-muted transition-colors">
          {t("home.viewProfile")}
          <span aria-hidden="true">→</span>
        </span>
      </a>

      <a
        href={localizePath("/negocios")}
        class="group block py-10 md:py-14 md:pl-12"
      >
        <h3 class="editorial-display text-2xl md:text-4xl text-paper mb-6 group-hover:text-paper-muted transition-colors duration-300">
          {t("home.forBusiness")}
        </h3>
        <p class="text-paper-muted leading-relaxed mb-8 text-pretty">
          {t("home.forBusinessDesc")}
        </p>
        <span class="editorial-meta text-paper inline-flex items-center gap-2 border-b border-paper pb-1 group-hover:border-paper-muted group-hover:text-paper-muted transition-colors">
          {t("home.viewServices")}
          <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </div>
</section>

<!-- Contact strip -->
<section class="border-t hairline bg-ink-raised">
  <div class="max-w-6xl mx-auto px-6 lg:px-12 py-16 md:py-24">
    <h2 class="editorial-display text-3xl md:text-5xl text-paper mb-4 text-balance">
      {t("home.contactTitle")}
    </h2>
    <p class="text-paper-muted text-lg mb-10 max-w-2xl leading-relaxed text-pretty">
      {t("home.contactDesc")}
    </p>
    <a
      href={`mailto:${SOCIAL_LINKS.email}`}
      class="editorial-display text-2xl md:text-4xl text-paper border-b border-paper hover:text-paper-muted hover:border-paper-muted transition-colors inline-block break-all pb-1"
    >
      {SOCIAL_LINKS.email}
      <span class="text-paper-dim"> →</span>
    </a>

    <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
      <a
        href={SOCIAL_LINKS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="editorial-meta text-paper-muted hover:text-paper transition-colors"
      >
        LinkedIn ↗
      </a>
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="editorial-meta text-paper-muted hover:text-paper transition-colors"
      >
        GitHub ↗
      </a>
    </div>
  </div>
</section>
